[Unit]
Description=PyPilot System Status Monitor (http://pypilotstatus.local)
Documentation=https://github.com/Flyguy86/ESP32-S3-BNO085-IMU-Gateway
After=network-online.target signalk.service avahi-daemon.service
Wants=network-online.target avahi-daemon.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Run as the autopilot user so ~/.pypilot and ~/pypilot are accessible
User=brian
Environment=HOME=/home/brian

# Script lives in /opt/pypilot-status/ after install
ExecStart=/usr/bin/python3 /opt/pypilot-status/pypilot-status.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
